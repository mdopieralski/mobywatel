{
  "name": "@mobywatel/pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "portless run --lan --name mobywatel -- vite",
    "serve": "portless run --lan --name mobywatel -- vite preview",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src e2e",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "5.3.0",
    "@gsap/react": "^2.1.2",
    "@mobywatel/brand": "workspace:*",
    "@mobywatel/content": "workspace:*",
    "@mobywatel/core": "workspace:*",
    "@mobywatel/ui": "workspace:*",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "^8.5.0",
    "remark-gfm": "4.0.1",
    "use-intl": "^4.14.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "portless": "^0.12.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
